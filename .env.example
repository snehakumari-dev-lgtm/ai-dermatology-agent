# Copy to backend/.env
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vision model. Put a trained checkpoint here (see ml/train.py output).
MODEL_CHECKPOINT=models/skin_lesion_effnet_b0.pt
# Only for pipeline demos: loads RANDOM weights, clearly labelled DEMO in the UI. Leave false normally.
ALLOW_UNTRAINED_DEMO=false
DEVICE=cpu
LOW_CONFIDENCE_THRESHOLD=0.5

# RAG backend: tfidf (default, offline) or faiss (pip install faiss-cpu sentence-transformers)
RAG_BACKEND=tfidf

# Optional LLM: any OpenAI-compatible endpoint. Leave key empty to use the template/extractive fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
